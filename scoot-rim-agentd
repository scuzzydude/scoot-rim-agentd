#!/usr/bin/env python3
"""scoot-rim-agentd — query the agent-session event log and ownership map.

No daemon yet, on purpose: every command here is a pure read of the log plus
(for `check`) the ownership map. That keeps the useful half available before any
service exists, and means the eventual daemon adds scheduling and an API rather
than logic.

Environment:
  SCOOT_RIM_EVENTS / SCOOT_RIM_HOME   where the event log lives
  SCOOT_RIM_OWNERSHIP                 path to the ownership map (site config)
"""

from __future__ import annotations

import argparse
import json
import os
import shlex
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from rimagentd import (  # noqa: E402
    KNOWN_EVENTS, EventLog, Ownership, OwnershipError, fold,
)


def _log(args) -> EventLog:
    return EventLog(args.log)


def _state(args):
    return fold(_log(args).records())


# -- players on demand (2026-11-25) -------------------------------------------
# Brandon: "I want the Captains to spin them up on demand." After a reboot only
# the captains come back (`restore --only-captains`); players stay held, bound
# and resumable ("dormant") until their captain runs rim/bin/player-up.

DEFAULT_ROSTER = os.environ.get("SCOOT_RIM_ROSTER", "/srv/steveai/rim/captains_roster.toml")
DEFAULT_PRIVATE = os.environ.get("SCOOT_RIM_PRIVATE", "/srv/steveai/scripts/ri_flow_exclude.txt")


def _roster(path: str = DEFAULT_ROSTER) -> tuple[set[str], dict[str, str]]:
    """(captain session names, {player name: captain session name})."""
    import tomllib
    try:
        with open(path, "rb") as f:
            caps = tomllib.load(f).get("captain", [])
    except FileNotFoundError:
        return set(), {}
    names, owner = set(), {}
    for c in caps:
        cap = f"[Captain]_{c.get('name', '')}"
        names.add(cap)
        for p in c.get("players", []) or []:
            owner[p] = cap
    return names, owner


def _private(path: str = DEFAULT_PRIVATE) -> tuple[set[str], list[str]]:
    """Private projects: never auto-restored or listed (names, path prefixes)."""
    names, prefixes = set(), []
    try:
        for line in open(path):
            line = line.split("#", 1)[0].strip()
            if not line:
                continue
            if line.startswith(("/", "~")):
                prefixes.append(os.path.realpath(os.path.expanduser(line)).rstrip("/"))
            else:
                names.add(line)
    except FileNotFoundError:
        pass
    return names, prefixes


def _is_private(s, priv) -> bool:
    names, prefixes = priv
    rp = os.path.realpath(s.cwd or "")
    return s.name in names or any(rp == p or rp.startswith(p + "/") for p in prefixes)


def _restore_filter(args, s, captains, priv) -> str:
    """Why `s` is NOT auto-restored, or "" if it is."""
    if _is_private(s, priv):
        return "private"
    if s.dormant:
        return "dormant"
    if getattr(args, "only_captains", False) and s.name not in captains:
        return "player"
    return ""


# -- commands ---------------------------------------------------------------

def cmd_live(args) -> int:
    state = _state(args)
    if not state.live:
        print("no live sessions in the log")
        return 0
    if args.json:
        # state: running | dormant (bound, not running) | broken (no id).
        # captain: the owning captain from the roster (null for captains/unknown).
        alive = _live_backend_names() or set()
        _, owner = _roster()
        out = []
        for s in state.sessions_sorted():
            d = dict(s.__dict__)
            d["state"] = ("running" if s.backend_id in alive
                          else "dormant" if s.bound else "broken")
            d["captain"] = owner.get(s.name)
            out.append(d)
        print(json.dumps(out, indent=2))
        return 0
    width = max(len(s.name) for s in state.live.values()) if state.live else 4
    for s in state.sessions_sorted():
        print(f"{s.name:<{width}}  {s.backend_id:<28}  "
              f"{'bound' if s.bound else 'UNBOUND':<8}  {s.cwd}")
    return 0


def cmd_tree(args) -> int:
    """Live sessions as a tree, grouped by position under the ownership root.

    Position is the organising fact everywhere else in this design — ownership,
    policy, restore — so it is what the display groups by too, rather than a flat
    list sorted by name. Reads the ownership map when available to annotate each
    node's policy; degrades to a plain tree when no map is configured, since
    seeing the sessions is useful even without policy.
    """
    state = _state(args)
    if not state.live:
        print("no live sessions in the log")
        return 0

    root = ""
    own = None
    try:
        own = Ownership.load(args.ownership)
        root = own.root
    except OwnershipError:
        pass  # no map configured — still worth showing the tree

    inside: list[tuple[str, object, str]] = []
    outside: list[object] = []
    partial = False
    for session in state.sessions_sorted():
        rel = own.relative(session.cwd) if (own and session.cwd) else None
        if rel is None:
            # Outside the managed tree (or no map at all). Splitting an absolute
            # path here would invent a bogus branch off the root — an earlier
            # version rendered "/ → home/ → steve/" under /srv/steveai — so these
            # get listed separately and honestly instead.
            outside.append(session)
            continue
        label = ""
        node = own.governing_node(session.cwd)
        if node is not None:
            label = node.policy
            # A node with `owns` claims only those globs, so its policy does NOT
            # govern this session's own directory — saying a bare "(strict)" next
            # to such a session overstates it. Mark it and explain once.
            if node.owns and not own.owner_of(session.cwd):
                label += "*"
                partial = True
        inside.append(("." if rel == "." else rel, session, label))
    inside.sort(key=lambda r: r[0])

    def _row(session, label, depth):
        pad = "  " * depth
        tags = "" if session.bound else "  [UNBOUND]"
        if session.cwd and not Path(session.cwd).is_dir():
            tags += "  [CWD GONE]"
        pol = f"  ({label})" if label else ""
        print(f"{pad}* {session.name}{pol}{tags}")

    print(root or "(no ownership root configured)")
    prev: list[str] = []
    for rel, session, label in inside:
        parts = [] if rel == "." else rel.split("/")
        # Print only the path segments that differ from the previous row, so
        # shared parents appear once instead of being repeated per session.
        common = 0
        while common < len(parts) and common < len(prev) and parts[common] == prev[common]:
            common += 1
        for depth in range(common, len(parts)):
            print(f"{'  ' * (depth + 1)}{parts[depth]}/")
        prev = parts
        _row(session, label, len(parts) + 1)

    if outside:
        print(f"\n(outside {root})" if root else "\n(no ownership map — position unknown)")
        for session in sorted(outside, key=lambda s: s.cwd or s.name):
            _row(session, "", 1)
            print(f"    {session.cwd or '<no cwd recorded>'}")

    if partial:
        print("\n* the governing node claims only named paths, so this session's own"
              "\n  directory is not itself governed by that policy — use `check` for a file")
    return 0


def cmd_open(args) -> int:
    """Deferred and escalated items with no matching resume/decide.

    These are the items most likely to be silently lost across a context
    turnover or a reboot, which is the reason the log records them at all.
    """
    state = _state(args)
    if not state.deferred and not state.escalated:
        print("nothing deferred or escalated")
        return 0
    for item, rec in sorted(state.deferred.items()):
        reason = rec.get("reason", "")
        print(f"DEFERRED   {item}" + (f"  — {reason}" if reason else ""))
    for question, rec in sorted(state.escalated.items()):
        to = rec.get("to", "")
        print(f"ESCALATED  {question}" + (f"  → {to}" if to else ""))
    return 0


def cmd_claims(args) -> int:
    state = _state(args)
    if not state.claims:
        print("no outstanding claims")
        return 0
    for resource, holder in sorted(state.claims.items()):
        session = state.live.get(holder)
        print(f"{resource}  held by {session.name if session else holder}")
    return 0


def cmd_restore_plan(args) -> int:
    """Print what a restore WOULD run. Never acts.

    Acting belongs in the daemon, where it can be logged as an action and
    gated — not in a CLI where it could be triggered by accident.
    """
    state = _state(args)
    if not state.live:
        print("# nothing to restore")
        return 0
    captains, _ = _roster()
    priv = _private()
    for s in state.sessions_sorted():
        why = _restore_filter(args, s, captains, priv)
        if why == "private":
            continue                      # never listed
        if why:
            print(f"# HOLD {s.name} — {why}; started on demand (rim/bin/player-up)")
            continue
        if not s.cwd:
            print(f"# SKIP {s.name} — no cwd recorded")
            continue
        if not Path(s.cwd).is_dir():
            print(f"# SKIP {s.name} — cwd no longer exists: {s.cwd}")
            continue
        if s.bound:
            inner = f"claude --name {shlex.quote(s.name)} --resume {s.agent_session_id}"
        else:
            print(f"# {s.name} — no agent_session_id; resume-by-directory is APPROXIMATE")
            inner = f"claude --name {shlex.quote(s.name)} --continue"
        print(
            f"(cd {shlex.quote(s.cwd)} && screen -dmS {shlex.quote(s.name)} && "
            f"screen -S {shlex.quote(s.name)} -X stuff {shlex.quote(inner + chr(13))})"
        )
    return 0


def cmd_restore(args) -> int:
    """Actually re-create live sessions. Guarded, and refuses by default when it
    would restore the wrong thing.

    The dangerous case is an UNBOUND session: with no agent_session_id the only
    option is resume-by-directory, which silently picks the most recent
    conversation in that directory. Where a directory has hosted several, that
    is the wrong one — and where the directory was renamed after the session
    started, there is no matching project dir at all and you get a blank
    session wearing the right name. So unbound sessions are skipped unless
    --allow-approximate says otherwise.
    """
    state = _state(args)
    log = _log(args)

    if not state.live:
        print("nothing to restore")
        return 0

    # Per session (2026-11-25): one unbound session used to block EVERY restore.
    # Now it is skipped and reported, and the rest still come back. Resuming it
    # by directory would attach to the wrong conversation or a blank one, so it
    # stays skipped unless --allow-approximate.
    captains, _ = _roster()
    priv = _private()

    import subprocess

    existing = set()
    try:
        out = subprocess.run(["screen", "-ls"], capture_output=True, text=True).stdout
        for line in out.splitlines():
            parts = line.split("\t")
            if len(parts) > 1 and "." in parts[1]:
                existing.add(parts[1].split(".", 1)[1])
    except FileNotFoundError:
        print("restore: 'screen' not found — cannot restore", file=sys.stderr)
        return 2

    restored = skipped = held = 0
    unbound_skipped = []
    for s in state.sessions_sorted():
        why = _restore_filter(args, s, captains, priv)
        if why:
            if why != "private":          # private projects are never listed
                print(f"HOLD  {s.name} — {why}; resumable on demand (rim/bin/player-up)")
            held += 1
            continue
        if not s.cwd or not Path(s.cwd).is_dir():
            print(f"SKIP  {s.name} — cwd missing: {s.cwd or '<none>'}")
            skipped += 1
            continue
        if s.name in existing:
            print(f"SKIP  {s.name} — a session by that name is already running")
            skipped += 1
            continue
        if not s.bound and not args.allow_approximate:
            print(f"SKIP  {s.name} — UNBOUND (no agent_session_id); fix its binding, "
                  f"or pass --allow-approximate")
            unbound_skipped.append(s.name)
            skipped += 1
            continue

        # --name as captain-launch.sh does: without it Claude names the resumed
        # session after its directory, and peers (ListAgents, player-up) see
        # "Bridge", not "[Captain]_Bridge". Seen on the 11-25 reboot.
        inner = (f"claude --name {shlex.quote(s.name)} "
                 + (f"--resume {s.agent_session_id}" if s.bound else "--continue"))
        if args.dry_run:
            print(f"WOULD {s.name}: {inner}  (cwd {s.cwd})")
            continue

        subprocess.run(["screen", "-dmS", s.name], cwd=s.cwd, check=False)
        subprocess.run(["screen", "-S", s.name, "-X", "stuff", inner + "\r"], check=False)

        # The new backend id, so the replacement session is recorded rather than
        # left to self-register. Restored sessions do NOT self-register: the
        # shell that starts has no agent session id yet (the agent has not
        # launched), and nothing re-runs registration once it has. Observed
        # live -- 11 of 13 restored screens were absent from the log, which also
        # silently voided a claim, because the fold drops claims held by a
        # session it does not know.
        new_id = ""
        try:
            out = subprocess.run(["screen", "-ls"], capture_output=True,
                                 text=True).stdout
            for line in out.splitlines():
                parts = line.split("\t")
                if len(parts) > 1 and parts[1].strip().endswith("." + s.name):
                    cand = parts[1].strip()
                    if cand != s.backend_id:
                        new_id = cand
                        break
        except FileNotFoundError:
            pass

        # Close the pre-reboot record FIRST. Without this the held session stays
        # live forever: reconcile deliberately will not close a previous-boot
        # session (that would destroy the recovery set), and nothing else did --
        # so all twelve accumulated as permanent ghosts alongside their own
        # replacements. Superseding is the one case where closing it is right,
        # because a successor now exists.
        if new_id and new_id != s.backend_id:
            log.append("session_exit", backend_id=s.backend_id, name=s.name,
                       reason=f"superseded by restore as {new_id}")
            log.append("session_start", name=s.name, backend_id=new_id,
                       cwd=s.cwd, pid=new_id.split(".", 1)[0], origin="restored")
            if s.bound:
                log.append("agent_bound", backend_id=new_id,
                           agent_session_id=s.agent_session_id, cwd=s.cwd,
                           origin="restored")

        log.append(
            "restored",
            name=s.name,
            cwd=s.cwd,
            backend_id=new_id or s.backend_id,
            previous_backend_id=s.backend_id if new_id else "",
            agent_session_id=s.agent_session_id,
            mode="resume" if s.bound else "continue-approximate",
        )
        print(f"RESTORED {s.name}  ({'resume' if s.bound else 'APPROXIMATE'})")
        restored += 1

    print(f"\n{restored} restored, {skipped} skipped, {held} held (dormant/players/private)")
    if unbound_skipped:
        print(f"{len(unbound_skipped)} skipped as UNBOUND: " + ", ".join(unbound_skipped))
    return 0


def _live_backend_names() -> set[str] | None:
    """Backend ids currently alive. None if the backend can't be queried, which
    must be distinguished from "nothing is alive" — reconciling on a failed
    query would mark every session dead."""
    import subprocess
    try:
        out = subprocess.run(["screen", "-ls"], capture_output=True, text=True).stdout
    except FileNotFoundError:
        return None
    ids = set()
    for line in out.splitlines():
        parts = line.split("\t")          # tab-delimited; names may contain spaces
        if len(parts) > 1 and "." in parts[1]:
            ids.add(parts[1].strip())
    return ids


def cmd_reconcile(args) -> int:
    """Close sessions the log thinks are live but the backend says are gone.

    Required rather than cosmetic: a session launcher returns when the user
    DETACHES, not when the session ends, and a killed session never logs its own
    exit. Without this, dead sessions look live forever — and a restore would
    try to re-create sessions that are actually still running, or skip real ones.
    """
    alive = _live_backend_names()
    if alive is None:
        print("reconcile: cannot query the session backend — refusing to guess",
              file=sys.stderr)
        return 2

    state = _state(args)
    log = _log(args)
    closed = held = 0
    for s in state.sessions_sorted():
        if s.backend_id in alive:
            continue
        # A session from a previous boot did not END -- the host restarted under
        # it. Closing it here would destroy the recovery set, and this timer runs
        # at boot (Persistent=true), so it would do so before anything could
        # restore. Verified: it emptied all twelve in one pass.
        # Stood down on purpose (rim/bin/player-down): bound, resumable, held.
        if s.dormant:
            held += 1
            continue
        if s.from_previous_boot and not args.close_previous_boot:
            if not args.quiet:
                print(f"held  {s.name} — was running before the last reboot; "
                      f"awaiting restore")
            held += 1
            continue
        log.append("session_exit", backend_id=s.backend_id, name=s.name,
                   reason="reconciled: backend reports not alive")
        if not args.quiet:
            print(f"closed {s.name} ({s.backend_id})")
        closed += 1
    if closed:
        log.append("reconcile", closed=str(closed))
    if not args.quiet:
        parts = []
        if closed:
            parts.append(f"{closed} closed")
        if held:
            parts.append(f"{held} held for restore")
        print(", ".join(parts) if parts else "nothing to reconcile")
    if held and not args.quiet:
        print("run 'scoot-rim-agentd restore' to bring the held sessions back")
    return 0


def cmd_check(args) -> int:
    """Would a session at --cwd be allowed to write PATH?

    This is the decision the eventual pre-write gate makes. Exposing it as a
    plain command means the policy can be reviewed and tested before anything
    enforces it.
    """
    try:
        own = Ownership.load(args.ownership)
    except OwnershipError as exc:
        print(f"scoot-rim-agentd: {exc}", file=sys.stderr)
        return 2

    cwd = args.cwd or os.getcwd()
    decision = own.check(args.path, cwd)
    verdict = "ALLOW" if decision.allowed else "DENY"
    print(f"{verdict}  {args.path}")
    print(f"       {decision.reason}")
    if not decision.allowed and decision.owner_cwd:
        print(f"       owner cwd: {decision.owner_cwd}")
    return 0 if decision.allowed else 1


def cmd_owner(args) -> int:
    try:
        own = Ownership.load(args.ownership)
    except OwnershipError as exc:
        print(f"scoot-rim-agentd: {exc}", file=sys.stderr)
        return 2
    node = own.owner_of(args.path)
    if node is None:
        print(f"{args.path}: outside any managed node")
        return 1
    print(f"{args.path}")
    print(f"  node   : {node.path}")
    print(f"  policy : {node.policy}")
    if node.owns:
        print(f"  owns   : {', '.join(node.owns)}")
    if node.note:
        print(f"  note   : {node.note}")
    return 0


def cmd_doctor(args) -> int:
    """Report what would make the log untrustworthy to act on.

    Note what this does NOT claim: an incomplete log is not a crisis when
    sessions can simply be restarted — a clean bring-up makes it complete,
    because sessions self-register at launch. It matters only where something
    consults the log to make a decision.
    """
    log = _log(args)
    state = _state(args)
    problems = 0

    if not log.path.exists():
        print(f"no log at {log.path} — nothing has been recorded yet")
        return 0

    bad = log.malformed()
    if bad:
        print(f"MALFORMED  {bad} unparseable line(s) in {log.path}")
        problems += bad

    for s in state.sessions_sorted():
        if not s.cwd:
            print(f"NO-CWD     {s.name} ({s.backend_id}) — cannot be restored")
            problems += 1
        elif not Path(s.cwd).is_dir():
            print(f"GONE-CWD   {s.name} — recorded cwd no longer exists: {s.cwd}")
            problems += 1
        if not s.bound:
            print(f"UNBOUND    {s.name} ({s.backend_id}) — restore would be approximate")
            problems += 1

    for resource, holder in sorted(state.claims.items()):
        if holder not in state.live:
            print(f"STALE-CLAIM {resource} — held by a session no longer live")
            problems += 1

    print(f"\n{len(state.live)} live, {len(state.exited)} exited, "
          f"{len(state.deferred)} deferred, {len(state.escalated)} escalated")
    if problems == 0:
        print("log is internally consistent and every live session is restorable")
        return 0
    print(f"{problems} issue(s) — see above")
    return 1


def cmd_serve(args) -> int:
    """Read-only HTTP view, for clients that cannot run this CLI (a tablet).

    Localhost unless --bind says otherwise: reaching a host on a restricted
    network from a tablet needs a decision about exposure, and that decision
    belongs to whoever runs the host rather than to a default here.
    """
    from rimagentd.api import serve

    token = args.token or ""
    if args.token == "-":                      # generate one and print it once
        import secrets
        token = secrets.token_urlsafe(16)

    url = f"http://{args.bind}:{args.port}/"
    print(f"serving read-only view on {url}")
    if args.bind not in ("127.0.0.1", "localhost"):
        print(f"  NOTE: bound to {args.bind} — reachable beyond this host")
    if token:
        print(f"  token: {token}")
        print(f"  open : {url}?token={token}")
    else:
        print("  no token — anyone who can reach this port can read session names/paths")
    print("  read-only: no endpoint here can restore, kill or modify anything")
    # Flush before blocking in serve_forever: stdout is block-buffered when
    # redirected to a file or journal, so without this the banner -- including a
    # generated token, which is printed exactly once -- stays invisible until
    # the process dies.
    sys.stdout.flush()
    try:
        serve(args.bind, args.port, token, args.log, args.ownership)
    except KeyboardInterrupt:
        print("\nstopped")
    except OSError as exc:
        print(f"scoot-rim-agentd: cannot serve on {args.bind}:{args.port} — {exc}",
              file=sys.stderr)
        return 2
    return 0


def cmd_suggest_bindings(args) -> int:
    """Propose an agent conversation for each unbound session, with evidence.

    Prints by default and writes only with --apply, because a wrong binding is
    worse than none: `restore` would resume the wrong conversation silently,
    whereas an absent binding makes it refuse and say why. Applied bindings are
    recorded with origin=inferred and their confidence, so the guess stays
    distinguishable from a session's own registration forever after.
    """
    from rimagentd.binding import suggest

    state = _state(args)
    unbound = [s for s in state.sessions_sorted() if not s.bound]
    if not unbound:
        print("every live session is already bound")
        return 0

    results = suggest(unbound)
    log = _log(args)
    applied = skipped = 0
    for s in unbound:
        res = results.get(s.backend_id, {})
        chosen = res.get("chosen")
        if chosen is None:
            n = len(res.get("candidates", []))
            why = "no project directory found for its cwd" if n == 0 else \
                  "every candidate is claimed by a session with better evidence"
            print(f"UNRESOLVED  {s.name}\n            {why}")
            skipped += 1
            continue

        conf = chosen.confidence
        print(f"{conf.upper():<10}  {s.name} -> {chosen.session_id}")
        print(f"            evidence: {', '.join(chosen.signals)}")
        if len(res["candidates"]) > 1:
            others = [c.session_id[:8] for c in res["candidates"][1:4]]
            print(f"            also possible: {', '.join(others)}")

        if not args.apply:
            continue
        if conf != "high" and not args.include_uncertain:
            print("            NOT applied — below high confidence"
                  " (use --include-uncertain to accept it)")
            skipped += 1
            continue
        log.append(
            "agent_bound",
            backend_id=s.backend_id,
            agent_session_id=chosen.session_id,
            cwd=s.cwd,
            origin="inferred",
            confidence=conf,
            evidence=",".join(chosen.signals),
        )
        print("            applied")
        applied += 1

    if args.apply:
        print(f"\n{applied} bound, {skipped} left unbound")
    else:
        print("\n(nothing written — pass --apply to record these)")
    return 0


def cmd_fix_cwd(args) -> int:
    """Correct a session's recorded working directory.

    Needed when a directory is renamed under a running session: the recorded
    position then points at something that no longer exists, and restore skips
    the session rather than reopening it somewhere wrong.

    Refuses a target that does not exist, because the whole failure being fixed
    is a recorded path that is not real. Position governs ownership as well as
    restore, so this is logged as its own event and never inferred.
    """
    state = _state(args)
    match = [s for s in state.sessions_sorted()
             if args.name in (s.name, s.backend_id)]
    if not match:
        print(f"scoot-rim-agentd: no live session named {args.name!r}", file=sys.stderr)
        return 2
    if len(match) > 1:
        print(f"scoot-rim-agentd: {args.name!r} matches several sessions; "
              f"use a backend_id: {', '.join(s.backend_id for s in match)}",
              file=sys.stderr)
        return 2

    session = match[0]
    new = str(Path(args.cwd).resolve())
    if not Path(new).is_dir():
        print(f"scoot-rim-agentd: {new} is not a directory — refusing "
              f"(a recorded path that is not real is the bug being fixed)",
              file=sys.stderr)
        return 2
    if new == session.cwd:
        print(f"{session.name} already records {new}")
        return 0

    _log(args).append("cwd_corrected", backend_id=session.backend_id,
                      name=session.name, cwd=new, previous_cwd=session.cwd,
                      reason=args.reason)
    print(f"{session.name}: {session.cwd or '<none>'}\n  -> {new}")
    return 0


def cmd_event(args) -> int:
    if len(args.kv) % 2 != 0:
        print("scoot-rim-agentd: event fields must be key/value pairs", file=sys.stderr)
        return 2
    fields = dict(zip(args.kv[::2], args.kv[1::2]))
    # Warn, do not reject: the log is append-only and extensible, so an unknown
    # type is legal. But a typo is otherwise accepted in silence and the item
    # never shows up in `open` -- which is how deferred work gets lost, the very
    # thing this log exists to prevent. Found by making exactly this mistake.
    if args.type not in KNOWN_EVENTS:
        print(f"scoot-rim-agentd: note — '{args.type}' is not a type the fold acts on;"
              f" it is recorded but will not appear in live/open/claims.",
              file=sys.stderr)
        print(f"  known: {', '.join(KNOWN_EVENTS)}", file=sys.stderr)
    # Who raised it is what makes an item returnable later: a defer with no session
    # cannot be handed back to whoever parked it, and the item is stuck until a human
    # happens to reread the log. Eleven of the first twelve defer/escalate events here
    # had no session, because every caller has to remember to pass one. Deriving it
    # from the session backend removes the remembering.
    #
    # Explicit always wins -- a supervising agent writing on another session's behalf
    # passes `session` deliberately, and must not be overwritten by its own $STY.
    if "session" not in fields:
        sty = os.environ.get("STY", "")
        if "." in sty:
            fields["session"] = sty.split(".", 1)[1]
    if args.type in ("defer", "escalate") and not fields.get("session"):
        print(f"scoot-rim-agentd: warning — no 'session' on this {args.type} and $STY is"
              f" unset, so nothing records who raised it. It cannot be handed back"
              f" later; pass 'session <name>' explicitly.", file=sys.stderr)

    record = _log(args).append(args.type, **fields)
    print(json.dumps(record, ensure_ascii=False))
    return 0


def cmd_tail(args) -> int:
    records = list(_log(args).records())
    for rec in records[-args.n:]:
        print(json.dumps(rec, ensure_ascii=False))
    return 0


def cmd_path(args) -> int:
    print(_log(args).path)
    return 0


# -- entry ------------------------------------------------------------------

def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="scoot-rim-agentd",
        description="Query the agent-session event log and ownership map.",
    )
    parser.add_argument("--log", help="event log path (default: $SCOOT_RIM_EVENTS)")
    parser.add_argument("--ownership", help="ownership map (default: $SCOOT_RIM_OWNERSHIP)")
    sub = parser.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("live", help="sessions started and not exited (the recovery set)")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_live)

    sub.add_parser("open", help="deferred/escalated with no resume/decide").set_defaults(func=cmd_open)
    sub.add_parser("claims", help="outstanding resource claims").set_defaults(func=cmd_claims)
    p = sub.add_parser("restore-plan", help="what a restore would run (prints only)")
    p.add_argument("--only-captains", action="store_true")
    p.set_defaults(func=cmd_restore_plan)

    p = sub.add_parser("restore", help="re-create live sessions (guarded)")
    p.add_argument("--dry-run", action="store_true", help="show what would run")
    p.add_argument("--only-captains", action="store_true",
                   help="restore only [Captain]_* sessions named in the roster; hold players as dormant")
    p.add_argument("--allow-approximate", action="store_true",
                   help="also restore sessions with no agent_session_id (may resume the WRONG conversation)")
    p.set_defaults(func=cmd_restore)
    sub.add_parser("doctor", help="what would make this log untrustworthy").set_defaults(func=cmd_doctor)
    sub.add_parser("tree", help="live sessions as a tree, grouped by position").set_defaults(func=cmd_tree)

    p = sub.add_parser("reconcile", help="close sessions the backend says are gone")
    p.add_argument("--quiet", action="store_true", help="only errors (for timers)")
    p.add_argument("--close-previous-boot", action="store_true",
                   help="also close sessions lost to a reboot (DISCARDS the recovery set)")
    p.set_defaults(func=cmd_reconcile)
    sub.add_parser("path", help="where the log lives").set_defaults(func=cmd_path)

    p = sub.add_parser("check", help="may a session at --cwd write PATH?")
    p.add_argument("path")
    p.add_argument("--cwd", help="calling session's cwd (default: this process's)")
    p.set_defaults(func=cmd_check)

    p = sub.add_parser("owner", help="which node owns PATH")
    p.add_argument("path")
    p.set_defaults(func=cmd_owner)

    p = sub.add_parser("serve", help="read-only HTTP view (for a tablet); localhost by default")
    p.add_argument("--bind", default="127.0.0.1",
                   help="address to bind (default 127.0.0.1; anything else is reachable off-host)")
    p.add_argument("--port", type=int, default=4300)
    p.add_argument("--token", default="",
                   help="require this bearer token; '-' generates one and prints it")
    p.set_defaults(func=cmd_serve)

    p = sub.add_parser("suggest-bindings",
                       help="propose an agent conversation for each unbound session")
    p.add_argument("--apply", action="store_true",
                   help="record the high-confidence matches as agent_bound events")
    p.add_argument("--include-uncertain", action="store_true",
                   help="with --apply, also record medium/low matches (may bind the WRONG conversation)")
    p.set_defaults(func=cmd_suggest_bindings)

    p = sub.add_parser("fix-cwd", help="correct a session's recorded directory (e.g. after a rename)")
    p.add_argument("name", help="session name or backend_id")
    p.add_argument("cwd", help="the directory it is actually in; must exist")
    p.add_argument("--reason", default="", help="why, for the log")
    p.set_defaults(func=cmd_fix_cwd)

    p = sub.add_parser("event", help="append an event")
    p.add_argument("type")
    p.add_argument("kv", nargs="*", metavar="KEY VALUE")
    p.set_defaults(func=cmd_event)

    p = sub.add_parser("tail", help="last N events")
    p.add_argument("n", nargs="?", type=int, default=20)
    p.set_defaults(func=cmd_tail)

    args = parser.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
